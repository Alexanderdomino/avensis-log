# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Auth + Firestore emulators instead of the real project.
# `npm run dev:emu` sets this for you via .env.emulator.
VITE_USE_EMULATORS=false
